            "asset": "npcs/biome/colourfulvillager.npctype",
            "pointer": "/scriptConfig/dialog/converse/apex/apex/2",
            "origin": "npcs/biome/colourfulvillager.npctype",
            "en": "Tell me what you know of the name Greenfinger.",
            "luna_tr": "Greenfinger adı hakkında bildiklerini anlat bana.",
            "approved_tr": "Greenfinger adı hakkında bildiklerini anlat bana.",
