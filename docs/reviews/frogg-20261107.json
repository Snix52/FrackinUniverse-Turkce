      "radio_messages": {
        "evernight01": {
          "operation_index": 260,
          "source": "radiomessages/missions.radiomessages.patch",
          "path": "/evernight01",
          "text": "The path forks here. I'm detecting lifesigns on both ends, so take your pick."
        },
        "evernight02": {
          "operation_index": 261,
          "source": "radiomessages/missions.radiomessages.patch",
          "path": "/evernight02",
          "text": "A frog village. How quaint. The locals don't look friendly."
        },
        "evernight03": {
          "operation_index": 262,
          "source": "radiomessages/missions.radiomessages.patch",
          "path": "/evernight03",
          "text": "This hatch seems to lead into some ruins. Maybe you should check around town to see if the locals have rigged some controls up."
        },
        "evernight04": {
          "operation_index": 263,
          "source": "radiomessages/missions.radiomessages.patch",
          "path": "/evernight04",
          "text": "The door's locked, and the switch is on the inside of the bell tower. Is there a way to trigger, or failing that, destroy it?"
        },
        "evernight05": {
          "operation_index": 264,
          "source": "radiomessages/missions.radiomessages.patch",
          "path": "/evernight05",
          "text": "Cultists! Just what are they doing here?"
        },
        "evernight06": {
          "operation_index": 265,
          "source": "radiomessages/missions.radiomessages.patch",
          "path": "/evernight06",
          "text": "This frog looks pretty lonely, I think he'd like your company."
        },
        "evernight07": {
          "operation_index": 266,
          "source": "radiomessages/missions.radiomessages.patch",
          "path": "/evernight07",
          "text": "Well, that was quite the sticky situation. Are you all right?"
        },
        "evernight08": {
          "operation_index": 267,
          "source": "radiomessages/missions.radiomessages.patch",
          "path": "/evernight08",
          "text": "This is an interesting one. Do you have a rocket launcher that can do guided rockets? I don't think you'll be able to reach the switch otherwise."
        },
        "evernight09": {
          "operation_index": 268,
          "source": "radiomessages/missions.radiomessages.patch",
          "path": "/evernight09",
          "text": "There's no way around it - the console holding the door shut is also connected to the hatch in front of you. I'm sorry, but to proceed you'll need to incinerate the dog."
        },
        "evernight10": {
          "operation_index": 269,
          "source": "radiomessages/missions.radiomessages.patch",
          "path": "/evernight10",
          "text": "Oh look, it's this again. To get at all those sweet, sweet pixels you'll need to consign this cat to a slow, painful, needless death."
        },
        "evernight11": {
          "operation_index": 270,
          "source": "radiomessages/missions.radiomessages.patch",
          "path": "/evernight11",
          "text": "Do you smell an ambush? Because all that darkness sure does."
        },
        "evernight12": {
          "operation_index": 271,
          "source": "radiomessages/missions.radiomessages.patch",
          "path": "/evernight12",
          "text": "Oh, I just figured out what else the cat console was linked to - the door you just came through. Good thing you weren't greedy and avoided being bitten in the ass by karma, eh?"
        }
      },
