          {
            "unit_index": 25,
            "asset": "npcs/pavillion/pavillionshogun.npctype",
            "pointer": "/scriptConfig/dialog/attack/hylotl/default/0",
            "origin": "npcs/pavillion/pavillionshogun.npctype",
            "en": "One of the princess' lapdogs! Time to test my blade on you!",
            "luna_tr": "Prensesin kucak köpeklerinden biri! Kılıcımı senin üzerinde deneme zamanı!",
            "approved_tr": "Prensesin uşaklarından biri! Kılıcımı senin üzerinde deneme zamanı!"
          },
          {
            "unit_index": 26,
            "asset": "npcs/pavillion/pavillionshogun.npctype",
            "pointer": "/scriptConfig/dialog/attack/hylotl/default/1",
            "origin": "npcs/pavillion/pavillionshogun.npctype",
            "en": "It is said, 'know your enemy and know yourself, and you will emerge the victor of a thousand battles'. You cannot hope to win.",
            "luna_tr": "“Düşmanını ve kendini tanı, bin savaştan galip çıkarsın” derler. Kazanmayı umut bile edemezsin.",
            "approved_tr": "“Düşmanını ve kendini tanı, bin savaştan galip çıkarsın” derler. Kazanma umudun yok."
          },
          {
            "unit_index": 27,
            "asset": "npcs/pavillion/pavillionshogun.npctype",
            "pointer": "/scriptConfig/dialog/attack/hylotl/default/2",
            "origin": "npcs/pavillion/pavillionshogun.npctype",
            "en": "The princess is mine! Mine! Mine!",
            "luna_tr": "Prenses benim! Benim! Benim!",
            "approved_tr": "Prenses benim! Benim! Benim!"
          },
          {
            "unit_index": 28,
            "asset": "npcs/pavillion/pavillionshogun.npctype",
            "pointer": "/scriptConfig/dialog/attack/hylotl/default/3",
            "origin": "npcs/pavillion/pavillionshogun.npctype",
            "en": "So, you invade my village and castle? Audacious indeed!",
            "luna_tr": "Demek köyümü ve kalemi istila ediyorsun? Cüretine bak!",
            "approved_tr": "Demek köyümü ve kalemi istila ediyorsun? Cüretine bak!"
          }
        ]
      }
