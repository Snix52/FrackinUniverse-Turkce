    {
      "asset": "objects/crafting/ppshoptruck/ppshoptruck.object",
      "pointer": "/chatOptions/0",
      "en": "Hey you - yeah, you! C'mere a sec. You want in on some killer deals?",
      "tr": "Hey sen, evet sen! Bir gelsene. Kaçırılmayacak fırsatlar ister misin?",
      "section": "v0.32 makine, üretim ve dükkân arayüzü"
    },
    {
      "asset": "objects/crafting/ppshoptruck/ppshoptruck.object",
      "pointer": "/chatOptions/1",
      "en": "Pssst - hey kid! You interested in some... Furniture and furniture byproducts?",
      "tr": "Pssst, hey çocuk! Şey... mobilya ve mobilya yan ürünleriyle ilgilenir misin?",
      "section": "v0.32 makine, üretim ve dükkân arayüzü"
    },
    {
      "asset": "objects/crafting/ppshoptruck/ppshoptruck.object",
      "pointer": "/chatOptions/2",
      "en": "OKEA? ... Nope, uh, can't ever say I've heard of 'em. ... What's with that look?",
      "tr": "OKEA mı? ... Yok, hiç duymadım. ... O bakış ne?",
      "section": "v0.32 makine, üretim ve dükkân arayüzü"
    },
    {
      "asset": "objects/crafting/ppshoptruck/ppshoptruck.object",
      "pointer": "/chatOptions/3",
      "en": "Quality goods here, fallen right off the back of a truck! ... Er, not this one, though.",
      "tr": "Kaliteli mallar burada, kamyonun arkasından düşmüş gibi! ... Ee, ama bu kamyondan değil tabii.",
      "section": "v0.32 makine, üretim ve dükkân arayüzü"
    },
    {
      "asset": "objects/crafting/ppshoptruck/ppshoptruck.object",
      "pointer": "/chatOptions/4",
      "en": "Where do I get this stuff? I got a, er, supplier. Honest Dave. Swell guy, really.",
      "tr": "Bunları nereden mi buluyorum? Şey, bir tedarikçim var. Dürüst Dave. Harika adamdır, gerçekten.",
      "section": "v0.32 makine, üretim ve dükkân arayüzü"
    },
    {
      "asset": "objects/crafting/ppshoptruck/ppshoptruck.object",
      "pointer": "/chatOptions/5",
      "en": "I'm upset to hear about Earth, don't get me wrong, but I'd be lying if I said I'm not relieved to get the Protectorate off of my flippers.",
      "tr": "Dünya'ya olanlara üzüldüm, yanlış anlama; ama Protectorate'in artık tepemde olmamasından rahatladığımı inkâr edemem.",
      "section": "v0.32 makine, üretim ve dükkân arayüzü"
    },
    {
      "asset": "objects/crafting/ppshoptruck/ppshoptruck.object",
      "pointer": "/chatOptions/6",
      "en": "What, you think I can't drive this thing? Me and my booster seat would like to disagree.",
      "tr": "Ne, bunu süremeyeceğimi mi sanıyorsun? Ben ve yükseltici koltuğum aksini düşünüyoruz.",
      "section": "v0.32 makine, üretim ve dükkân arayüzü"
    },
