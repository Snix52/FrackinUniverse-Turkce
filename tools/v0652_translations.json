{
  "translation_version": "0.65.2-beta",
  "source_repository": "sayterdarkwynd/FrackinUniverse",
  "source_commit": "bb58383c0d16c1152e3439e606b39ff82288b586",
  "source_declared_version": "6.5.8",
  "scope": "All remaining Slimeperson and Shadow S.A.I.L. ship wakeUp/wakePlayer dialogue fields",
  "translations": [
    {
      "asset": "objects/ship/slimepersontechstation/slimepersontechstation.object",
      "pointer": "/dialog/wakeUp/0/0",
      "en": "I'm alive!",
      "tr": "Yaşıyorum!",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/slimepersontechstation/slimepersontechstation.object",
      "pointer": "/dialog/wakeUp/1/0",
      "en": "Hello symbiote. I'm SAIL. I operate this ship.",
      "tr": "Merhaba, simbiyot. Ben S.A.I.L.; bu gemiyi yönetiyorum.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/slimepersontechstation/slimepersontechstation.object",
      "pointer": "/dialog/wakeUp/2/0",
      "en": "I'm sure we'll be great friends.",
      "tr": "Çok iyi arkadaş olacağız, eminim.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/slimepersontechstation/slimepersontechstation.object",
      "pointer": "/dialog/wakeUp/3/0",
      "en": "If you don't die first, I guess.",
      "tr": "Tabii önce ölmezsen.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/slimepersontechstation/slimepersontechstation.object",
      "pointer": "/dialog/wakeUp/4/0",
      "en": "What was that thing that attacked Earth? It looked like nothing in my databanks.",
      "tr": "Dünya'ya saldıran o şey neydi? Veri tabanımda benzerini bulamıyorum.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/slimepersontechstation/slimepersontechstation.object",
      "pointer": "/dialog/wakeUp/5/0",
      "en": "At least we're still in one piece. I'm not sure where we are, though.",
      "tr": "En azından hâlâ tek parçayız. Yalnız nerede olduğumuzu bilmiyorum.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/slimepersontechstation/slimepersontechstation.object",
      "pointer": "/dialog/wakePlayer/0/0",
      "en": "I'm down, please help.",
      "tr": "Devre dışıyım, yardım et lütfen.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/slimepersontechstation/slimepersontechstation.object",
      "pointer": "/dialog/wakePlayer/1/0",
      "en": "I'm not working right, reboot me.",
      "tr": "Bir terslik var, beni yeniden başlat.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/slimepersontechstation/slimepersontechstation.object",
      "pointer": "/dialog/wakePlayer/2/0",
      "en": "Boot me up, I'm offline.",
      "tr": "Çevrim dışıyım, beni aç.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/slimepersontechstation/slimepersontechstation.object",
      "pointer": "/dialog/wakePlayer/3/0",
      "en": "Help me, I'm broken.",
      "tr": "Yardım et, bozulmuşum.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/slimepersontechstation/slimepersontechstation.object",
      "pointer": "/dialog/wakePlayer/4/0",
      "en": "Are you there?",
      "tr": "Orada mısın?",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/slimepersontechstation/slimepersontechstation.object",
      "pointer": "/dialog/wakePlayer/5/0",
      "en": "I'm so sleepy.",
      "tr": "Çok uykum var.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/shadowtechstation/shadowtechstation.object",
      "pointer": "/dialog/wakeUp/0/0",
      "en": "...Initializing bootup sequence...",
      "tr": "...Başlatma işlemi başlıyor...",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/shadowtechstation/shadowtechstation.object",
      "pointer": "/dialog/wakeUp/1/0",
      "en": "I am S.A.I.L, your Ship-based Artificial Intelligence Lattice. I manage the maintainance of your ship.",
      "tr": "Ben S.A.I.L., gemi tabanlı bir yapay zekâ ağıyım. Geminin bakımını yönetiyorum.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/shadowtechstation/shadowtechstation.object",
      "pointer": "/dialog/wakeUp/2/0",
      "en": "I am set to mimic species designation: Human. Reason: Unknown.",
      "tr": "Taklit edilecek tür: İnsan. Nedeni bilinmiyor.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/shadowtechstation/shadowtechstation.object",
      "pointer": "/dialog/wakeUp/3/0",
      "en": "Error: Ship is damaged. Fragment must repair our means of transport.",
      "tr": "Hata: Gemi hasarlı. Fragment ulaşım aracımızı onarmalı.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/shadowtechstation/shadowtechstation.object",
      "pointer": "/dialog/wakeUp/4/0",
      "en": "Our location is currently unknown. Fragment should explore orbited world for means of repair.",
      "tr": "Konumumuz bilinmiyor. Fragment onarım için yörüngedeki gezegeni araştırmalı.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/shadowtechstation/shadowtechstation.object",
      "pointer": "/dialog/wakePlayer/0/0",
      "en": "Fragment should interface with the system.",
      "tr": "Fragment sistemle bağlantı kurmalı.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/shadowtechstation/shadowtechstation.object",
      "pointer": "/dialog/wakePlayer/1/0",
      "en": "Fragment. Please reboot the system.",
      "tr": "Fragment, lütfen sistemi yeniden başlat.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/shadowtechstation/shadowtechstation.object",
      "pointer": "/dialog/wakePlayer/2/0",
      "en": "To awaken, Fragment must interface.",
      "tr": "Uyanmam için Fragment sistemle bağlantı kurmalı.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/shadowtechstation/shadowtechstation.object",
      "pointer": "/dialog/wakePlayer/3/0",
      "en": "Fragment must interface.",
      "tr": "Fragment sistemle bağlantı kurmak zorunda.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/shadowtechstation/shadowtechstation.object",
      "pointer": "/dialog/wakePlayer/4/0",
      "en": "Proceeding requires interfacing with the Fragment.",
      "tr": "Devam etmek için Fragment'la bağlantı kurulmalı.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    },
    {
      "asset": "objects/ship/shadowtechstation/shadowtechstation.object",
      "pointer": "/dialog/wakePlayer/5/0",
      "en": "Rebooting requires a conscious entity to interact with the S.A.I.L console.",
      "tr": "Yeniden başlatma için bilinçli bir varlığın S.A.I.L. konsoluyla etkileşime geçmesi gerekir.",
      "section": "v0.65.2 S.A.I.L. gemi konuşmaları"
    }
  ]
}
