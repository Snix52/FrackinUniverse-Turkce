  "translations": [
    {
      "asset": "npcs/nightar/friendlykingslayer.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/0",
      "en": "I guard the path set by the Matriarch.",
      "tr": "Matriarch'ın belirlediği yolu koruyorum.",
      "section": "v0.85 Nightar konuşmaları"
    },
    {
      "asset": "npcs/nightar/friendlykingslayer.npctype",
      "pointer": "/scriptConfig/dialog/cantReach/default/default/0",
      "en": "The darkness will turn on you...!",
      "tr": "Karanlık sana düşman kesilecek...!",
      "section": "v0.85 Nightar konuşmaları"
    },
    {
      "asset": "npcs/nightar/friendlykingslayer.npctype",
      "pointer": "/scriptConfig/dialog/cheerOn/default/default/0",
      "en": "Show them no quarter!",
      "tr": "Onlara aman vermeyin!",
      "section": "v0.85 Nightar konuşmaları"
    },
    {
      "asset": "npcs/nightar/friendlykingslayer.npctype",
      "pointer": "/scriptConfig/dialog/killedTarget/default/default/0",
      "en": "The foe is slain. Thank you for your assistance, my friend. Until we meet again.",
      "tr": "Düşman öldürüldü. Yardımın için teşekkürler, dostum. Yeniden görüşmek üzere.",
      "section": "v0.85 Nightar konuşmaları"
    },
    {
      "asset": "npcs/nightar/friendlykingslayer.npctype",
      "pointer": "/scriptConfig/dialog/lostTarget/default/default/0",
      "en": "There is no where to hide.",
      "tr": "Saklanacak yer yok.",
      "section": "v0.85 Nightar konuşmaları"
    },
    {
      "asset": "npcs/nightar/friendlykingslayer.npctype",
      "pointer": "/scriptConfig/dialog/outOfSight/default/default/0",
      "en": "It is pointless to hide!",
      "tr": "Saklanmak boşuna!",
      "section": "v0.85 Nightar konuşmaları"
    },
    {
      "asset": "npcs/nightar/friendlykingslayer.npctype",
      "pointer": "/scriptConfig/dialog/reattack/default/default/0",
      "en": "Face my wrath, you wretch!",
      "tr": "Gazabımla yüzleş, zavallı!",
      "section": "v0.85 Nightar konuşmaları"
    },
    {
      "asset": "npcs/nightar/nightarkavaserai.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/0",
      "en": "Attack!",
      "tr": "Saldır!",
      "section": "v0.85 Nightar konuşmaları"
    },
    {
      "asset": "npcs/nightar/nightarkavaserai.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/1",
      "en": "Your death comes this day.",
      "tr": "Bugün öleceksin.",
      "section": "v0.85 Nightar konuşmaları"
    },
    {
      "asset": "npcs/nightar/nightarkavaserai.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/2",
      "en": "Blade and sinew. The way is clear.",
      "tr": "Kılıç ve kas gücü. Yol açık.",
      "section": "v0.85 Nightar konuşmaları"
    },
    {
      "asset": "npcs/nightar/nightarkavaserai.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/3",
      "en": "Honor meets honor. Blood meets blood.",
      "tr": "Şeref şerefle buluşur. Kan kanla buluşur.",
      "section": "v0.85 Nightar konuşmaları"
    },
    {
      "asset": "npcs/nightar/nightarkavaserai.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/4",
      "en": "I do as She commands.",
      "tr": "Matriarch'ın buyruğunu yerine getiririm.",
      "section": "v0.85 Nightar konuşmaları"
    },
    {
      "asset": "npcs/nightar/nightarking.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/0",
      "en": "I am Heptarch. I alone defeated one-thousand foes and was made glorious through victory. Kneel.",
      "tr": "Ben Heptarch'ım. Tek başıma bin düşmanı yendim; zaferle yüceldim. Diz çök.",
      "section": "v0.85 Nightar konuşmaları"
    },
    {
      "asset": "npcs/nightar/nightarking.npctype",
      "pointer": "/scriptConfig/dialog/cantReach/default/default/0",
      "en": "You will not escape, wretch.",
      "tr": "Kaçamayacaksın, sefil.",
      "section": "v0.85 Nightar konuşmaları"
    },
    {
      "asset": "npcs/nightar/nightarking.npctype",
      "pointer": "/scriptConfig/dialog/cheerOn/default/default/0",
      "en": "Onward!",
      "tr": "İleri!",
      "section": "v0.85 Nightar konuşmaları"
    },
    {
      "asset": "npcs/nightar/nightarking.npctype",
      "pointer": "/scriptConfig/dialog/killedTarget/default/default/0",
      "en": "Crushed like the insect you are.",
      "tr": "Bir böcek gibi ezildin.",
      "section": "v0.85 Nightar konuşmaları"
    },
    {
      "asset": "npcs/nightar/nightarking.npctype",
      "pointer": "/scriptConfig/dialog/lostTarget/default/default/0",
      "en": "It is pointless to hide!",
      "tr": "Saklanmak boşuna!",
      "section": "v0.85 Nightar konuşmaları"
    },
    {
      "asset": "npcs/nightar/nightarking.npctype",
      "pointer": "/scriptConfig/dialog/outOfSight/default/default/0",
      "en": "You really believe the darkness to be your ally, challenger...?",
      "tr": "Karanlığın müttefikin olduğuna gerçekten inanıyor musun, meydan okuyucu...?",
      "section": "v0.85 Nightar konuşmaları"
    },
    {
      "asset": "npcs/nightar/nightarking.npctype",
      "pointer": "/scriptConfig/dialog/reattack/default/default/0",
      "en": "There will be no honor in your death.",
      "tr": "Ölümünde şeref olmayacak.",
      "section": "v0.85 Nightar konuşmaları"
    },
    {
      "asset": "npcs/nightar/nightarking.npctype",
      "pointer": "/scriptConfig/dialog/reattack/default/default/1",
      "en": "May She guide my blade.",
      "tr": "Matriarch kılıcıma yol göstersin.",
      "section": "v0.85 Nightar konuşmaları"
    },
