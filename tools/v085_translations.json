    {
      "asset": "npcs/nightar/nightarkingsguard.npctype",
      "pointer": "/scriptConfig/dialog/attack/nightar/default/1",
      "en": "Our swordsmanship is unparalleled!",
      "tr": "Kılıç ustalığımızın eşi benzeri yok!",
      "section": "v0.85 Nightar konuşmaları"
    },
