    {
      "asset": "npcs/nightar/nightarkingsguard.npctype",
      "pointer": "/scriptConfig/dialog/attack/nightar/default/0",
      "en": "You want a fight? Very well!",
      "tr": "Dövüş mü istiyorsun? Öyle olsun!",
