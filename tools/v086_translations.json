    },
    {
      "asset": "npcs/snowcrash/snowcrashhostage.npctype",
      "pointer": "/scriptConfig/dialog/converse/apex/default/0",
      "en": "If you've cleared the dacha, I should be able to handle myself. Don't worry about me and head down to the basement.",
      "tr": "Daçayı temizlediysen kendi başımın çaresine bakabilirim sanırım. Benim için endişelenme, bodruma in.",
