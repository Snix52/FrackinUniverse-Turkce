    {
      "asset": "npcs/snowcrash/snowcrashcomissar.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/0",
      "en": "You dare break into my home? You will die!",
      "tr": "Evime izinsiz girmeye nasıl cüret edersin? Öleceksin!",
      "section": "v0.86 Snow Crash görev konuşmaları"
    },
    {
      "asset": "npcs/snowcrash/snowcrashguard.npctype",
      "pointer": "/scriptConfig/dialog/attack/apex/default/0",
      "en": "You die today!",
      "tr": "Bugün öleceksin!",
      "section": "v0.86 Snow Crash görev konuşmaları"
    },
    {
      "asset": "npcs/snowcrash/snowcrashguard.npctype",
      "pointer": "/scriptConfig/dialog/attack/apex/default/1",
      "en": "Your struggle is futile.",
      "tr": "Direnişin boşuna.",
      "section": "v0.86 Snow Crash görev konuşmaları"
    },
    {
      "asset": "npcs/snowcrash/snowcrashguard.npctype",
      "pointer": "/scriptConfig/dialog/attack/apex/default/2",
      "en": "You sure have a lot of gall coming here!",
      "tr": "Buraya gelmekle büyük küstahlık ettin!",
      "section": "v0.86 Snow Crash görev konuşmaları"
    },
    {
      "asset": "npcs/snowcrash/snowcrashguard.npctype",
      "pointer": "/scriptConfig/dialog/attack/apex/default/3",
      "en": "There's a thought reassignment room waiting for you!",
      "tr": "Seni düşüncelerini yeniden düzenleyecekleri bir oda bekliyor!",
      "section": "v0.86 Snow Crash görev konuşmaları"
    },
    {
      "asset": "npcs/snowcrash/snowcrashguard.npctype",
      "pointer": "/scriptConfig/dialog/attack/apex/default/4",
      "en": "I love you Winter-Chan!",
      "tr": "Winter-Chan, seni seviyorum!",
      "section": "v0.86 Snow Crash görev konuşmaları"
    },
    {
      "asset": "npcs/snowcrash/snowcrashguard.npctype",
      "pointer": "/scriptConfig/dialog/attack/apex/default/5",
      "en": "You made a big mistake coming here!",
      "tr": "Buraya gelmekle büyük hata ettin!",
      "section": "v0.86 Snow Crash görev konuşmaları"
    },
