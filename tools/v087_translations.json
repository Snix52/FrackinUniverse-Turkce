  "translations": [
    {
      "asset": "npcs/volcanobase/volcanobasebrute.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/0",
      "en": "Enraged. Raaaarrrgh!",
      "tr": "Çileden çıkmış. Raaaarrrgh!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasebrute.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/1",
      "en": "Bloodthirsty. Crush! Kill! Destroy!",
      "tr": "Kana susamış. Ez! Öldür! Yok et!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasebrute.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/2",
      "en": "Fanatical. Fear the might of the warlords!",
      "tr": "Fanatik. Savaş ağalarının gücünden korkun!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasebrute.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/3",
      "en": "Deranged. I will break you!",
      "tr": "Çılgın. Seni dize getireceğim!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasebrute.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/4",
      "en": "Confident. I am unstoppable!",
      "tr": "Kendinden emin. Durdurulamam!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasebrute.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/5",
      "en": "Enraged. Death to intruders!",
      "tr": "Çileden çıkmış. İzinsiz girenlere ölüm!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasedagger.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/0",
      "en": "Dark. The Master shall not be disturbed!",
      "tr": "Kasvetli. Efendi rahatsız edilmeyecek!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasedagger.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/1",
      "en": "Confident. You cannot withstand our power!",
      "tr": "Kendinden emin. Gücümüze karşı koyamazsın!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasedagger.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/2",
      "en": "Fanatical. The tower is invincible!",
      "tr": "Fanatik. Kule yenilmez!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasedagger.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/3",
      "en": "Enraged. Death to intruders!",
      "tr": "Çileden çıkmış. İzinsiz girenlere ölüm!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/attack/default/default/0",
      "en": "Valorous. Into the fray!",
      "tr": "Yiğitçe. Haydi çarpışmaya!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/attack/default/default/1",
      "en": "Enraged. Your blood will soil the land!",
      "tr": "Çileden çıkmış. Kanın bu toprağı kirletecek!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/attack/default/default/2",
      "en": "Grim. To battle!",
      "tr": "Ciddi. Savaşa!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/join/default/default/0",
      "en": "Grateful. Thank you for rescuing me.",
      "tr": "Minnettar. Beni kurtardığın için teşekkür ederim.",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/join/default/default/1",
      "en": "Eager. Allow me to do my duty as a knight and join you.",
      "tr": "Hevesli. Bir şövalye olarak görevimi yerine getirip sana katılmama izin ver.",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/join/default/default/2",
      "en": "Vengeful. Let me after those who locked me in here!",
      "tr": "İntikam peşinde. Beni buraya kilitleyenlerin peşine düşmeme izin ver!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/returnFromCombat/default/default/0",
      "en": "Victorious. You are no match for me!",
      "tr": "Galip. Bana denk değilsin!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/returnFromCombat/default/default/1",
      "en": "Dark. You are weak!",
      "tr": "Kasvetli. Zayıfsın!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/returnFromCombat/default/default/2",
      "en": "Smug. Is this the best of the Warlord's lackeys?",
      "tr": "Kendini beğenmiş. Savaş ağasının uşaklarının en iyisi bu mu?",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/returnFromCombat/default/default/3",
      "en": "Pumped. Is that all they have to throw at us?",
      "tr": "Coşkulu. Bize karşı çıkarabildikleri bu kadar mı?",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/returnFromCombat/default/default/4",
      "en": "Calm. Rest in peace.",
      "tr": "Sakin. Huzur içinde yat.",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/returnFromWait/default/default/0",
      "en": "Acknowledgement. Greetings once more.",
      "tr": "Onay. Yeniden selamlar.",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/returnFromWait/default/default/1",
      "en": "Excited. Let's head off together!",
      "tr": "Heyecanlı. Haydi birlikte yola çıkalım!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/returnFromWait/default/default/2",
      "en": "Eager. You ready to move on?",
      "tr": "Hevesli. Yola devam etmeye hazır mısın?",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/wait/default/default/0",
      "en": "Unhappy. Must you go on without me? I wish to fight for glory!",
      "tr": "Mutsuz. Bensiz devam etmek zorunda mısın? Şan kazanmak için savaşmak istiyorum!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/wait/default/default/1",
      "en": "Thankful. You are kind to scout ahead.",
      "tr": "Minnettar. Önden keşfe çıkman çok ince bir davranış.",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/wait/default/default/2",
      "en": "Bored. Guard duty, eh?",
      "tr": "Sıkılmış. Nöbet tutmak, ha?",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/wait/default/default/3",
      "en": "Questioning. Do you need a moment?",
      "tr": "Sorgulayıcı. Biraz zamana mı ihtiyacın var?",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasehostage.npctype",
      "pointer": "/scriptConfig/dialog/converse/default/default/0",
      "en": "I have nothing to sssay to you",
      "tr": "Sana sssöyleyecek bir şeyim yok.",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasehostage.npctype",
      "pointer": "/scriptConfig/dialog/converse/glitch/default/0",
      "en": "Shocked. Who are you? Are you here to defeat the warlord?",
      "tr": "Şaşkın. Sen kimsin? Savaş ağasını yenmeye mi geldin?",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasehostage.npctype",
      "pointer": "/scriptConfig/dialog/converse/glitch/default/1",
      "en": "Upset. The warlord has taken us hostage to insure our kingdoms' compliance.",
      "tr": "Üzgün. Savaş ağası, krallıklarımızı itaate zorlamak için bizi rehin aldı.",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasehostage.npctype",
      "pointer": "/scriptConfig/dialog/converse/glitch/default/2",
      "en": "Encouraging. Slay the warlord and free us!",
      "tr": "Teşvik edici. Savaş ağasını öldür ve bizi özgürlüğümüze kavuştur!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasehostage.npctype",
      "pointer": "/scriptConfig/dialog/converse/glitch/default/3",
      "en": "Resigned. I wish I could do more to help you, but we are kept here all the time. I do not know much of the tower.",
      "tr": "Kabullenmiş. Sana daha fazla yardım edebilmeyi isterdim ama bizi hep burada tutuyorlar. Kule hakkında fazla bir şey bilmiyorum.",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasehunter.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/0",
      "en": "Attack!",
      "tr": "Saldır!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasehunter.npctype",
      "pointer": "/scriptConfig/dialog/attack/glitch/default/0",
      "en": "Cryptic. I owe you nothing but an arrow through the eye.",
      "tr": "Gizemli. Sana borcum, gözüne saplanacak bir oktan ibaret.",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasehunter.npctype",
      "pointer": "/scriptConfig/dialog/attack/glitch/default/1",
      "en": "Menacing. Stay back, or I'll put one through your knee!",
      "tr": "Tehditkâr. Uzak dur, yoksa dizine bir ok saplarım!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasehunter.npctype",
      "pointer": "/scriptConfig/dialog/attack/glitch/default/2",
      "en": "Grim. One shot, intruder. That's all I'll need.",
      "tr": "Ciddi. Tek atış yeter, davetsiz misafir. Bana gereken bu kadar.",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobaselord.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/0",
      "en": "Attack!",
      "tr": "Saldır!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobaselord.npctype",
      "pointer": "/scriptConfig/dialog/attack/glitch/default/0",
      "en": "Furious. I'll slaughter you and use your loot to replace the guards you killed!",
      "tr": "Öfkeli. Seni katledeceğim; ganimetini, öldürdüğün muhafızların yerine yenilerini koymak için kullanacağım!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobaselord.npctype",
      "pointer": "/scriptConfig/dialog/attack/glitch/default/1",
      "en": "Eager. And so the hero arrives! Brave and foolish, my favourite type. I will break you and relish every moment of it.",
      "tr": "Hevesli. Ve işte kahraman geldi! Cesur ve budala; en sevdiğim tip. Seni dize getireceğim ve bunun her anından zevk alacağım.",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobaselord.npctype",
      "pointer": "/scriptConfig/dialog/attack/glitch/default/2",
      "en": "Haughty. A protector to slaughter, just for me! This will be a crowning achievement; today my legend grows ever larger!",
      "tr": "Kibirli. Sırf benim katletmem için bir Protector! Bu, başarılarımın tacı olacak; bugün efsanem daha da büyüyecek!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobaselord.npctype",
      "pointer": "/scriptConfig/dialog/attack/glitch/default/3",
      "en": "Smug. My, my! If a protector feels the need to challenge me, I must be doing something right. Step up and lend your head to one of my many pikes.",
      "tr": "Kendini beğenmiş. Vay, vay! Bir Protector bana meydan okuma gereği duyuyorsa, demek ki doğru bir şeyler yapıyorum. Öne çık da başını onca mızrağımdan birine ödünç ver.",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasesentinel.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/0",
      "en": "Dark. You will regret coming here!",
      "tr": "Kasvetli. Buraya geldiğine pişman olacaksın!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasesentinel.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/1",
      "en": "Bloodthirsty. Your blood will soil the land!",
      "tr": "Kana susamış. Kanın bu toprağı kirletecek!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasesentinel.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/2",
      "en": "Fanatical. Die, fool!",
      "tr": "Fanatik. Öl, aptal!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasesentinel.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/3",
      "en": "Determined. We are the unyielding.",
      "tr": "Kararlı. Biz asla boyun eğmeyiz.",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasesentinel.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/4",
      "en": "Confident. I am unstoppable!",
      "tr": "Kendinden emin. Durdurulamam!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    },
    {
      "asset": "npcs/volcanobase/volcanobasesentinel.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/5",
      "en": "Enraged. Death to intruders!",
      "tr": "Çileden çıkmış. İzinsiz girenlere ölüm!",
      "section": "v0.87 Volcano Base görev konuşmaları"
    }
  ]
