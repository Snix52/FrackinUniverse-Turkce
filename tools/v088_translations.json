  "translations": [
    {
      "asset": "npcs/ancienttemple/battlepriest.npctype",
      "pointer": "/scriptConfig/dialog/attack/avian/default/0",
      "en": "Filthy Grounded scum! Today, you die!",
      "tr": "Seni pis Grounded artığı! Bugün öleceksin!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/battlepriest.npctype",
      "pointer": "/scriptConfig/dialog/attack/avian/default/1",
      "en": "Rend the unbeliever limb from limb!",
      "tr": "İnançsızı lime lime edin!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/battlepriest.npctype",
      "pointer": "/scriptConfig/dialog/attack/avian/default/2",
      "en": "Your disbelief will be your undoing!",
      "tr": "İnançsızlığın seni mahvedecek!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/battlepriest.npctype",
      "pointer": "/scriptConfig/dialog/attack/avian/default/3",
      "en": "I’ll kill you myself, scum!",
      "tr": "Seni kendi ellerimle öldüreceğim, pislik!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/battlepriest.npctype",
      "pointer": "/scriptConfig/dialog/attack/avian/default/4",
      "en": "Your disregard towards our mighty Kluex is despicable!",
      "tr": "Yüce Kluex'i hiçe sayman iğrenç!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/battlepriest.npctype",
      "pointer": "/scriptConfig/dialog/attack/avian/default/5",
      "en": "By Kluex be purged!",
      "tr": "Kluex seni arındırsın!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/battlepriest.npctype",
      "pointer": "/scriptConfig/dialog/attack/avian/default/6",
      "en": "I... I must destroy you, heretic! I have no choice!",
      "tr": "Ben... Seni yok etmeliyim, sapkın! Başka çarem yok!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/battlepriest.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/0",
      "en": "A sacrifice presents itself!",
      "tr": "Karşıma bir kurban çıktı!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/battlepriest.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/1",
      "en": "How fortuitous. Usually a sacrifice won't present itself so readily!",
      "tr": "Ne güzel rastlantı! Normalde bir kurban karşıma bu kadar kolay çıkmaz!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/battlepriest.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/2",
      "en": "You dishonour Kluex!",
      "tr": "Kluex'e saygısızlık ediyorsun!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/battlepriest.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/3",
      "en": "You are unwelcome, stranger!",
      "tr": "Burada istenmiyorsun, yabancı!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/battlepriest.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/4",
      "en": "Today, Kluex claims another soul!",
      "tr": "Bugün Kluex bir ruh daha alacak!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/battlepriest.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/5",
      "en": "The wrath of Kluex will fall upon you!",
      "tr": "Kluex'in gazabı üzerine çökecek!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/battlepriest.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/6",
      "en": "The power of Kluex compels me to slay you!",
      "tr": "Kluex'in kudreti beni seni katletmeye zorluyor!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/firebird.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/0",
      "en": "Be wreathed in holy flame!",
      "tr": "Kutsal alevler seni sarsın!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/firebird.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/1",
      "en": "You shall burn for your trespass!",
      "tr": "İzinsiz girişin yüzünden yanacaksın!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/firebird.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/2",
      "en": "Burn for the glory of Kluex!",
      "tr": "Kluex'in şanı uğruna yan!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/firebird.npctype",
      "pointer": "/scriptConfig/dialog/killedTarget/default/default/0",
      "en": "Ashes to ashes!",
      "tr": "Külden küle!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/firebird.npctype",
      "pointer": "/scriptConfig/dialog/reattack/default/default/0",
      "en": "I shall purify your mind with my sacred flame!",
      "tr": "Kutsal alevimle zihnini arındıracağım!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/templefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/attack/default/default/0",
      "en": "Sacrifice me, will you?",
      "tr": "Beni kurban edecektin, öyle mi?",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/templefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/attack/default/default/1",
      "en": "I'll escape or die trying!",
      "tr": "Ya kaçacağım ya da kaçmaya çalışırken öleceğim!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/templefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/join/default/default/0",
      "en": "Thank you for saving me! I don't fancy being a sacrifice.",
      "tr": "Beni kurtardığın için teşekkür ederim! Kurban edilmeyi hiç istemem.",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/templefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/join/default/default/1",
      "en": "I had almost lost all hope of being rescued! Let's get out of here!",
      "tr": "Kurtarılacağıma dair umudumu neredeyse yitirmiştim! Haydi, buradan çıkalım!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/templefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/returnFromCombat/default/default/0",
      "en": "Let's move on.",
      "tr": "Yola devam edelim.",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/templefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/returnFromCombat/default/default/1",
      "en": "I'm impressed.",
      "tr": "Etkilendim.",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/templefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/returnFromCombat/default/default/2",
      "en": "How did you get here anyway?",
      "tr": "Bu arada, buraya nasıl geldin?",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/templefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/returnFromCombat/default/default/3",
      "en": "We're a team worth fearing!",
      "tr": "Korkulacak bir ekibiz!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/templefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/returnFromCombat/default/default/4",
      "en": "Who's the sacrifice now?",
      "tr": "Şimdi kurban kim oldu?",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/templefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/returnFromWait/default/default/0",
      "en": "Hello again.",
      "tr": "Tekrar merhaba.",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/templefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/returnFromWait/default/default/1",
      "en": "Let's head off together.",
      "tr": "Haydi birlikte yola çıkalım.",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/templefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/returnFromWait/default/default/2",
      "en": "You ready to move on?",
      "tr": "Yola devam etmeye hazır mısın?",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/templefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/wait/default/default/0",
      "en": "I'll just wait here.",
      "tr": "Ben burada bekleyeceğim.",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/templefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/wait/default/default/1",
      "en": "I'll stay here, don't leave me alone too long!",
      "tr": "Burada kalacağım; beni fazla uzun süre yalnız bırakma!",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
    {
      "asset": "npcs/ancienttemple/templefollower.npctype",
      "pointer": "/scriptConfig/dialog/follower/wait/default/default/2",
      "en": "Do you need a moment?",
      "tr": "Biraz zamana mı ihtiyacın var?",
      "section": "v0.88 Ancient Temple görev konuşmaları"
    },
