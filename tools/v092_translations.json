    {
      "asset": "npcs/pavillion/pavillionprincess.npctype",
      "pointer": "/scriptConfig/dialog/converse/default/default/0",
      "en": "Thank you! Sorry, but your princess is in another castle!",
      "tr": "Teşekkürler! Kusura bakma ama prensesin başka bir kalede!",
      "section": "v0.92 Pavillion konuşmaları"
    },
    {
      "asset": "npcs/pavillion/pavillionprincess.npctype",
      "pointer": "/scriptConfig/dialog/converse/default/default/1",
      "en": "Eh...yes, that was a bad joke. Pardon me, I just thought to lighten the mood a little.",
      "tr": "Ee... evet, kötü bir şakaydı. Affet, sadece ortamı biraz yumuşatmak istemiştim.",
      "section": "v0.92 Pavillion konuşmaları"
    },
    {
      "asset": "npcs/pavillion/pavillionprincess.npctype",
      "pointer": "/scriptConfig/dialog/converse/default/default/2",
      "en": "It must have been something of an ordeal to get here. No, I'm not hurt.",
      "tr": "Buraya gelmek epey zorlu olmuştur. Hayır, yaralanmadım.",
      "section": "v0.92 Pavillion konuşmaları"
    },
    {
      "asset": "npcs/pavillion/pavillionprincess.npctype",
      "pointer": "/scriptConfig/dialog/converse/default/default/3",
      "en": "We need to get out of here quickly before reinforcements arrive. Maybe you can activate the teleporter in the room above.",
      "tr": "Takviye gelmeden buradan çabucak çıkmalıyız. Belki yukarıdaki odada bulunan Işınlayıcıyı çalıştırabilirsin.",
      "section": "v0.92 Pavillion konuşmaları"
    },
    {
      "asset": "npcs/pavillion/pavillionprincess.npctype",
      "pointer": "/scriptConfig/dialog/converse/default/default/4",
      "en": "Let's just grab what treasure is here and go!",
      "tr": "Burada ne hazine varsa toplayıp gidelim!",
      "section": "v0.92 Pavillion konuşmaları"
    },
    {
      "asset": "npcs/pavillion/pavillionprincess.npctype",
      "pointer": "/scriptConfig/dialog/speak/default/default/0",
      "en": "Thank you for rescuing me!",
      "tr": "Beni kurtardığın için teşekkür ederim!",
      "section": "v0.92 Pavillion konuşmaları"
    },
    {
      "asset": "npcs/pavillion/pavillionsamurai.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/0",
      "en": "Attack!",
      "tr": "Saldır!",
      "section": "v0.92 Pavillion konuşmaları"
    },
    {
      "asset": "npcs/pavillion/pavillionsamurai.npctype",
      "pointer": "/scriptConfig/dialog/attack/hylotl/default/0",
      "en": "For the glory of Shogun Kigai!",
      "tr": "Şogun Kigai’nin şanı için!",
      "section": "v0.92 Pavillion konuşmaları"
    },
    {
      "asset": "npcs/pavillion/pavillionsamurai.npctype",
      "pointer": "/scriptConfig/dialog/attack/hylotl/default/1",
      "en": "I will slay you!",
      "tr": "Seni öldüreceğim!",
      "section": "v0.92 Pavillion konuşmaları"
    },
    {
      "asset": "npcs/pavillion/pavillionsamurai.npctype",
      "pointer": "/scriptConfig/dialog/attack/hylotl/default/2",
      "en": "A thousand blows shall rain upon you!",
      "tr": "Üzerine bin darbe yağacak!",
      "section": "v0.92 Pavillion konuşmaları"
    },
    {
      "asset": "npcs/pavillion/pavillionsamurai.npctype",
      "pointer": "/scriptConfig/dialog/attack/hylotl/default/3",
      "en": "Banzai!",
      "tr": "Hücuuum!",
      "section": "v0.92 Pavillion konuşmaları"
    },
    {
      "asset": "npcs/pavillion/pavillionshogun.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/0",
      "en": "Attack!",
      "tr": "Saldır!",
      "section": "v0.92 Pavillion konuşmaları"
    },
    {
      "asset": "npcs/pavillion/pavillionshogun.npctype",
      "pointer": "/scriptConfig/dialog/attack/hylotl/default/0",
      "en": "One of the princess' lapdogs! Time to test my blade on you!",
      "tr": "Prensesin uşaklarından biri! Kılıcımı senin üzerinde deneme zamanı!",
      "section": "v0.92 Pavillion konuşmaları"
    },
    {
      "asset": "npcs/pavillion/pavillionshogun.npctype",
      "pointer": "/scriptConfig/dialog/attack/hylotl/default/1",
      "en": "It is said, 'know your enemy and know yourself, and you will emerge the victor of a thousand battles'. You cannot hope to win.",
      "tr": "“Düşmanını ve kendini tanı, bin savaştan galip çıkarsın” derler. Kazanma umudun yok.",
      "section": "v0.92 Pavillion konuşmaları"
    },
    {
      "asset": "npcs/pavillion/pavillionshogun.npctype",
      "pointer": "/scriptConfig/dialog/attack/hylotl/default/2",
      "en": "The princess is mine! Mine! Mine!",
      "tr": "Prenses benim! Benim! Benim!",
      "section": "v0.92 Pavillion konuşmaları"
    },
    {
      "asset": "npcs/pavillion/pavillionshogun.npctype",
      "pointer": "/scriptConfig/dialog/attack/hylotl/default/3",
      "en": "So, you invade my village and castle? Audacious indeed!",
      "tr": "Demek köyümü ve kalemi istila ediyorsun? Cüretine bak!",
      "section": "v0.92 Pavillion konuşmaları"
    }
