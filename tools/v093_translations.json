    },
    {
      "asset": "npcs/magickaforest/magickaguard.npctype",
      "pointer": "/scriptConfig/dialog/converse/default/default/0",
      "en": "You shouldn't be seeing this.",
      "tr": "Bunu görüyor olmamalısın.",
      "section": "v0.93 Magicka Forest konuşmaları"
    },
    {
      "asset": "npcs/magickaforest/magickaguard.npctype",
      "pointer": "/scriptConfig/dialog/converse/glitch/default/0",
      "en": "Nervous. This is my first tour of duty.",
      "tr": "Gergin. İlk görev dönemimdeyim.",
      "section": "v0.93 Magicka Forest konuşmaları"
    },
    {
      "asset": "npcs/magickaforest/magickaguard.npctype",
      "pointer": "/scriptConfig/dialog/converse/glitch/default/1",
      "en": "Apprehensive. We have asked the monks to retreat to safety until the raiders are defeated.",
      "tr": "Endişeli. Yağmacılar yenilene kadar keşişlerden güvenli bir yere çekilmelerini istedik.",
      "section": "v0.93 Magicka Forest konuşmaları"
    },
    {
      "asset": "npcs/magickaforest/magickaguard.npctype",
      "pointer": "/scriptConfig/dialog/converse/glitch/default/2",
      "en": "Optimistic. The monastery walls will confer us a significant defensive advantage.",
      "tr": "İyimser. Manastırın duvarları savunmada bize önemli bir üstünlük sağlayacak.",
      "section": "v0.93 Magicka Forest konuşmaları"
    },
    {
      "asset": "npcs/magickaforest/magickaguard.npctype",
      "pointer": "/scriptConfig/dialog/converse/glitch/default/3",
      "en": "Uncertain. The alpaca are very good at hiding in the ruins.",
      "tr": "Tereddütlü. Alpakalar harabelerde saklanmakta çok iyiler.",
      "section": "v0.93 Magicka Forest konuşmaları"
    },
    {
      "asset": "npcs/magickaforest/magickaguard.npctype",
      "pointer": "/scriptConfig/dialog/converse/glitch/default/4",
      "en": "Adventurous. I hear the ruins go much deeper than one might think. I would like to explore someday.",
      "tr": "Maceracı. Duyduğuma göre harabeler sanıldığından çok daha derine uzanıyormuş. Bir gün oraları keşfetmek isterim.",
      "section": "v0.93 Magicka Forest konuşmaları"
    },
    {
      "asset": "npcs/magickaforest/magickaguard.npctype",
      "pointer": "/scriptConfig/dialog/converse/glitch/default/5",
      "en": "Grim. Alpaca raiders have troubled Glitch settlements for generations.",
      "tr": "Ciddi. Alpaka yağmacılar nesillerdir Glitch yerleşimlerine musallat oluyor.",
      "section": "v0.93 Magicka Forest konuşmaları"
    },
    {
      "asset": "npcs/magickaforest/magickaguard.npctype",
      "pointer": "/scriptConfig/dialog/converse/glitch/default/6",
      "en": "Hopeful. Perhaps a seasoned adventurer like you will deal with the problem without us needing to intervene.",
      "tr": "Umutlu. Belki senin gibi deneyimli bir maceracı, bizim müdahale etmemize gerek kalmadan sorunu çözer.",
      "section": "v0.93 Magicka Forest konuşmaları"
    },
    {
      "asset": "npcs/magickaforest/magickaguard.npctype",
      "pointer": "/scriptConfig/dialog/converse/glitch/default/7",
      "en": "Earnest. Shear a handful of those overgrown sheep for me, will you?",
      "tr": "İçten. Şu azman koyunlardan birkaçını benim için kırkıver, olur mu?",
      "section": "v0.93 Magicka Forest konuşmaları"
    },
    {
      "asset": "npcs/magickaforest/magickaguard.npctype",
      "pointer": "/scriptConfig/dialog/converse/glitch/default/8",
      "en": "Determined. These monasteries preserve much knowledge and culture in these dark times. They must be protected.",
      "tr": "Kararlı. Bu manastırlar, karanlık zamanlarda pek çok bilgi ve kültürü koruyor. Korunmaları gerekiyor.",
      "section": "v0.93 Magicka Forest konuşmaları"
    },
    {
      "asset": "npcs/magickaforest/magickajarl.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/0",
      "en": "Tae Glitch have sent a champion, I see.",
      "tr": "Demek Glitchler bir şampiyon göndermiş.",
      "section": "v0.93 Magicka Forest konuşmaları"
    },
    {
      "asset": "npcs/magickaforest/magickajarl.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/1",
      "en": "I was gettin' tired anyways...",
      "tr": "Zaten yorulmaya başlamıştım...",
      "section": "v0.93 Magicka Forest konuşmaları"
    },
    {
      "asset": "npcs/magickaforest/magickajarl.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/2",
      "en": "Tae heck with ye!",
      "tr": "Cehenneme kadar yolun var!",
      "section": "v0.93 Magicka Forest konuşmaları"
    },
    {
      "asset": "npcs/magickaforest/magickajarl.npctype",
      "pointer": "/scriptConfig/dialog/attack/default/default/3",
      "en": "Tae Glitch can only send a wee craven to face me?",
      "tr": "Glitchler karşıma yalnızca küçücük bir korkak mı gönderebiliyor?",
      "section": "v0.93 Magicka Forest konuşmaları"
    }
  ]
