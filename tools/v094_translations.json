      "section": "v0.94 Mount Gigant konuşmaları"
    },
    {
      "asset": "npcs/japaneseruins/japaneseruinsvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/default/default/0",
      "en": "You shouldn't be seeing this.",
      "tr": "Bunu görüyor olmamalısın.",
      "section": "v0.94 Mount Gigant konuşmaları"
    },
    {
      "asset": "npcs/japaneseruins/japaneseruinsvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/hylotl/default/0",
      "en": "Rumour has it there is a great treasure in the ruins, but no one dares go search.",
      "tr": "Söylentiye göre harabelerde büyük bir hazine var ama kimse onu aramaya cesaret edemiyor.",
      "section": "v0.94 Mount Gigant konuşmaları"
    },
    {
      "asset": "npcs/japaneseruins/japaneseruinsvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/hylotl/default/1",
      "en": "It's said that the ruins are cursed. People who venture in there are transformed into oni.",
      "tr": "Harabelerin lanetli olduğu söyleniyor. Oraya girenler Oni’ye dönüşüyormuş.",
      "section": "v0.94 Mount Gigant konuşmaları"
    },
    {
      "asset": "npcs/japaneseruins/japaneseruinsvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/hylotl/default/2",
      "en": "There are many restless spirits in the mountain ruins.",
      "tr": "Dağ harabelerinde huzur bulamayan pek çok ruh var.",
      "section": "v0.94 Mount Gigant konuşmaları"
    },
    {
      "asset": "npcs/japaneseruins/japaneseruinsvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/hylotl/default/3",
      "en": "Even the village is supposed to harbour an important secret, but no one has found it yet.",
      "tr": "Köyün bile önemli bir sır sakladığı söyleniyor ama henüz kimse onu bulamadı.",
      "section": "v0.94 Mount Gigant konuşmaları"
    },
    {
      "asset": "npcs/japaneseruins/japaneseruinsvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/hylotl/default/4",
      "en": "Many go into the mountain ruins, but few return.",
      "tr": "Dağ harabelerine pek çok kişi giriyor ama pek azı geri dönüyor.",
      "section": "v0.94 Mount Gigant konuşmaları"
    },
    {
      "asset": "npcs/japaneseruins/japaneseruinsvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/hylotl/default/5",
      "en": "There are said to be irregularities in the ruin walls that can be dug out with a matter manipulator.",
      "tr": "Harabe duvarlarında Madde Manipülatörü ile kazılabilecek sıra dışı kısımlar olduğu söyleniyor.",
      "section": "v0.94 Mount Gigant konuşmaları"
    },
    {
      "asset": "npcs/japaneseruins/japaneseruinsvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/hylotl/default/6",
      "en": "Vicious oni are said to live in the ruins, men warped by power...but that's just a tale.",
      "tr": "Harabelerde vahşi Oni’lerin yaşadığı, bunların gücün bozduğu insanlar olduğu söyleniyor... Ama bu sadece bir hikâye.",
      "section": "v0.94 Mount Gigant konuşmaları"
    },
    {
      "asset": "npcs/japaneseruins/japaneseruinsvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/hylotl/default/7",
      "en": "The mountain ruins are littered with many secrets. Keep your eyes peeled for loose tiles.",
      "tr": "Dağ harabeleri sırlarla dolu. Gevşek karoları gözden kaçırma.",
      "section": "v0.94 Mount Gigant konuşmaları"
    },
    {
      "asset": "npcs/japaneseruins/japaneseruinsvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/hylotl/default/8",
      "en": "Five gems of power are said to lead the way to the ruins' treasure.",
      "tr": "Beş güç mücevherinin harabelerdeki hazineye giden yolu gösterdiği söyleniyor.",
      "section": "v0.94 Mount Gigant konuşmaları"
    }
  ]
