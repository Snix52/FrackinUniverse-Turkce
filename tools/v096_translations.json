  "language_review": "docs/reviews/colourful-20261106.json",
  "translations": [
    {
      "asset": "npcs/biome/colourfulvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/apex/apex/0",
      "en": "You... your face is familiar, somehow.",
      "tr": "Sen... yüzün nedense tanıdık geliyor.",
      "section": "v0.96 Renkli Apex köylüsünün anıları"
    },
    {
      "asset": "npcs/biome/colourfulvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/apex/apex/1",
      "en": "Were we once alike, Ape?",
      "tr": "Bir zamanlar birbirimize benziyor muyduk, maymun?",
      "section": "v0.96 Renkli Apex köylüsünün anıları"
    },
    {
      "asset": "npcs/biome/colourfulvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/apex/apex/2",
      "en": "Tell me what you know of the name Greenfinger.",
      "tr": "Greenfinger adı hakkında bildiklerini anlat bana.",
      "section": "v0.96 Renkli Apex köylüsünün anıları"
    },
    {
      "asset": "npcs/biome/colourfulvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/apex/apex/3",
      "en": "Why do you seem so familiar? It is like... no, I can't think.",
      "tr": "Neden bu kadar tanıdık geliyorsun? Sanki... hayır, düşünemiyorum.",
      "section": "v0.96 Renkli Apex köylüsünün anıları"
    },
    {
      "asset": "npcs/biome/colourfulvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/apex/apex/4",
      "en": "Have we met before, Ape?",
      "tr": "Daha önce karşılaştık mı, maymun?",
      "section": "v0.96 Renkli Apex köylüsünün anıları"
    },
    {
      "asset": "npcs/biome/colourfulvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/apex/apex/5",
      "en": "Seeing you makes me feel an alarming nostalgia. Why?",
      "tr": "Seni görünce içimde ürkütücü bir geçmiş özlemi uyanıyor. Neden?",
      "section": "v0.96 Renkli Apex köylüsünün anıları"
    },
    {
      "asset": "npcs/biome/colourfulvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/apex/apex/6",
      "en": "Outside I am colourful, inside I am grey.",
      "tr": "Dışım renkli, içim gri.",
      "section": "v0.96 Renkli Apex köylüsünün anıları"
    },
    {
      "asset": "npcs/biome/colourfulvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/apex/apex/7",
      "en": "I had... a family, once. They were like you.",
      "tr": "Bir ailem vardı... bir zamanlar. Senin gibiydiler.",
      "section": "v0.96 Renkli Apex köylüsünün anıları"
    },
    {
      "asset": "npcs/biome/colourfulvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/apex/default/0",
      "en": "What... have I become?",
      "tr": "Neye... dönüştüm ben?",
      "section": "v0.96 Renkli Apex köylüsünün anıları"
    },
    {
      "asset": "npcs/biome/colourfulvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/apex/default/1",
      "en": "My fur, it's... colourful.",
      "tr": "Kürküm... rengârenk.",
      "section": "v0.96 Renkli Apex köylüsünün anıları"
    },
    {
      "asset": "npcs/biome/colourfulvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/apex/default/2",
      "en": "I remember... bananas.",
      "tr": "Hatırlıyorum... muzları.",
      "section": "v0.96 Renkli Apex köylüsünün anıları"
    },
    {
      "asset": "npcs/biome/colourfulvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/apex/default/3",
      "en": "My dreams are haunted by a giant ape. What does this mean?",
      "tr": "Rüyalarıma dev bir maymun musallat oluyor. Bu ne anlama geliyor?",
      "section": "v0.96 Renkli Apex köylüsünün anıları"
    },
    {
      "asset": "npcs/biome/colourfulvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/apex/default/4",
      "en": "I fell asleep at my desk and when I awoke, I'd written the word 'Miniknog' over and over.",
      "tr": "Masamın başında uyuyakaldım. Uyandığımda “Miniknog” sözcüğünü defalarca yazmış olduğumu gördüm.",
      "section": "v0.96 Renkli Apex köylüsünün anıları"
    },
    {
      "asset": "npcs/biome/colourfulvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/apex/default/5",
      "en": "What colourful fur I have! So strange.",
      "tr": "Kürküm ne kadar renkli! Çok tuhaf.",
      "section": "v0.96 Renkli Apex köylüsünün anıları"
    },
    {
      "asset": "npcs/biome/colourfulvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/apex/default/6",
      "en": "I feel like everything has changed overnight.",
      "tr": "Her şey bir gecede değişmiş gibi geliyor.",
      "section": "v0.96 Renkli Apex köylüsünün anıları"
    },
    {
      "asset": "npcs/biome/colourfulvillager.npctype",
      "pointer": "/scriptConfig/dialog/converse/default/default/0",
      "en": "What... have I become?",
      "tr": "Neye... dönüştüm ben?",
      "section": "v0.96 Renkli Apex köylüsünün anıları"
    }
  ]
}
